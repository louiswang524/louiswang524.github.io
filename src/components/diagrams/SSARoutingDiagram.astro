---
const W = 580, H = 270;
const N_KEYS = 12;
const TOKEN_W = 36, TOKEN_H = 22;
const KEY_PITCH = 46;
// Center-align 12 tokens across W
const KEY_X0 = (W - (N_KEYS - 1) * KEY_PITCH) / 2; // = 37
const KEY_TOP = 28;
const KEY_BOT = KEY_TOP + TOKEN_H; // = 50

const ROUTER_X1 = 218, ROUTER_X2 = 362;
const ROUTER_Y1 = 138, ROUTER_Y2 = 166;
const ROUTER_CX = (ROUTER_X1 + ROUTER_X2) / 2; // = 290
const ROUTER_CY = (ROUTER_Y1 + ROUTER_Y2) / 2;

const QUERY_W = 52, QUERY_H = 24;
const QUERY_TOP = 216;
const QUERY_X = W / 2 - QUERY_W / 2; // centered
const QUERY_CX = W / 2;
const QUERY_CY = QUERY_TOP + QUERY_H / 2;

// Selected key indices (0-based) — spread across the full sequence
const SELECTED = new Set([0, 3, 7, 10]);

interface KeyToken {
  k: number;
  cx: number;
  selected: boolean;
}

const keyTokens: KeyToken[] = Array.from({ length: N_KEYS }, (_, k) => ({
  k,
  cx: KEY_X0 + k * KEY_PITCH,
  selected: SELECTED.has(k),
}));

const selectedCxs = keyTokens.filter((t) => t.selected).map((t) => t.cx);
---

<svg
  width="100%"
  viewBox={`0 0 ${W} ${H}`}
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; max-width: 100%; margin: 2rem 0; overflow: visible;"
  aria-label="SSA routing: a query token selects k=4 key positions based on content, not position"
>
  <!-- Lines: router top → selected key bottoms (behind tokens) -->
  {selectedCxs.map((cx) => (
    <line
      x1={ROUTER_CX} y1={ROUTER_Y1}
      x2={cx} y2={KEY_BOT}
      stroke="var(--accent)" stroke-width="1.3"
      stroke-dasharray="4 2" opacity="0.7"
    />
  ))}

  <!-- Line: query top → router bottom -->
  <line
    x1={QUERY_CX} y1={QUERY_TOP}
    x2={ROUTER_CX} y2={ROUTER_Y2}
    stroke="var(--accent)" stroke-width="1.5" opacity="0.7"
  />

  <!-- Key tokens -->
  {keyTokens.map(({ k, cx, selected }) => (
    <g>
      <rect
        x={cx - TOKEN_W / 2} y={KEY_TOP}
        width={TOKEN_W} height={TOKEN_H} rx="4"
        fill={selected ? 'var(--accent)' : 'var(--bg-subtle)'}
        fill-opacity={selected ? 0.85 : 1}
        stroke={selected ? 'var(--accent)' : 'var(--border)'}
        stroke-width="1"
      />
      <text
        x={cx} y={KEY_TOP + TOKEN_H / 2 + 4}
        text-anchor="middle"
        font-family="var(--font-mono)" font-size="9"
        fill={selected ? 'white' : 'var(--text-muted)'}
      >{k + 1}</text>
    </g>
  ))}

  <!-- Router box -->
  <rect
    x={ROUTER_X1} y={ROUTER_Y1}
    width={ROUTER_X2 - ROUTER_X1} height={ROUTER_Y2 - ROUTER_Y1}
    rx="6"
    fill="var(--bg-subtle)" stroke="var(--accent)"
    stroke-width="1.5" stroke-dasharray="5 2"
  />
  <text
    x={ROUTER_CX} y={ROUTER_CY + 4}
    text-anchor="middle" font-family="var(--font-sans)"
    font-size="11" font-weight="600" fill="var(--text-muted)"
  >Content Router</text>

  <!-- Query token -->
  <rect
    x={QUERY_X} y={QUERY_TOP}
    width={QUERY_W} height={QUERY_H} rx="5"
    fill="var(--accent)" fill-opacity="0.9"
    stroke="var(--accent)" stroke-width="1.5"
  />
  <text
    x={QUERY_CX} y={QUERY_TOP + QUERY_H / 2 + 4}
    text-anchor="middle" font-family="var(--font-sans)"
    font-size="10" font-weight="600" fill="white"
  >Query</text>

  <!-- Caption -->
  <text x={W / 2} y={H - 12} text-anchor="middle"
        font-family="var(--font-sans)" font-size="10" fill="var(--text-muted)">
    k = 4 selected positions (highlighted) out of 12 — based on query meaning, not position
  </text>
</svg>
