---
const W = 580, H = 240;

const MODELS = ['SubQ', 'Opus 4.6', 'GPT-5.5', 'Gemini 3.1'];
const COLORS = ['var(--accent)', '#3b82f6', '#22c55e', '#f59e0b'];

// MRCR v2 8-needle @ 1M tokens (Appen third-party verified)
const MRCR = [86.2, 78.3, 74.0, 26.3];
// SWE-Bench Verified
const SWE  = [81.8, 80.8, 80.0, 80.6];

const PANEL_W = 260;
const PANEL_GAP = 60;
const PANEL_A_X = 20;
const PANEL_B_X = PANEL_A_X + PANEL_W + PANEL_GAP;

const LABEL_W = 72;
const SCORE_W = 36;
const BAR_MAX_W = PANEL_W - LABEL_W - SCORE_W; // ~152
const TITLE_Y = 22;
const BAR_H = 22;
const BAR_GAP = 8;
const BARS_Y_START = TITLE_Y + 18;

function barW(score: number): number {
  return (score / 100) * BAR_MAX_W;
}
function barY(i: number): number {
  return BARS_Y_START + i * (BAR_H + BAR_GAP);
}
---

<svg
  width="100%"
  viewBox={`0 0 ${W} ${H}`}
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; max-width: 100%; margin: 2rem 0; overflow: visible;"
  aria-label="Benchmark comparison: MRCR v2 and SWE-Bench scores across SubQ, Claude Opus 4.6, GPT-5.5, Gemini 3.1 Pro"
>
  {[
    { title: 'MRCR v2 — 8-needle @ 1M tokens', scores: MRCR, px: PANEL_A_X },
    { title: 'SWE-Bench Verified',              scores: SWE,  px: PANEL_B_X },
  ].map(({ title, scores, px }) => (
    <g>
      <text x={px + PANEL_W / 2} y={TITLE_Y}
            text-anchor="middle" font-family="var(--font-sans)"
            font-size="11" font-weight="600" fill="var(--text-muted)">{title}</text>

      {MODELS.map((model, i) => {
        const y = barY(i);
        const bw = barW(scores[i]);
        const barX = px + LABEL_W;
        return (
          <g>
            <text x={px + LABEL_W - 6} y={y + BAR_H / 2 + 4}
                  text-anchor="end" font-family="var(--font-sans)"
                  font-size="10" fill="var(--text-muted)">{model}</text>
            <rect x={barX} y={y} width={bw} height={BAR_H} rx="3"
                  fill={COLORS[i]} fill-opacity={i === 0 ? 0.88 : 0.55} />
            <text x={barX + bw + 4} y={y + BAR_H / 2 + 4}
                  font-family="var(--font-mono)" font-size="10"
                  fill={i === 0 ? COLORS[i] : 'var(--text-muted)'}
                  font-weight={i === 0 ? '600' : '400'}>
              {scores[i].toFixed(1)}%
            </text>
          </g>
        );
      })}

      <!-- x-axis baseline -->
      <line x1={px + LABEL_W} y1={barY(MODELS.length - 1) + BAR_H + 4}
            x2={px + LABEL_W + BAR_MAX_W} y2={barY(MODELS.length - 1) + BAR_H + 4}
            stroke="var(--border)" stroke-width="0.5" />
    </g>
  ))}
</svg>
