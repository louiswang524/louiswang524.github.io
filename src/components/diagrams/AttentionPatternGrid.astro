---
const CELL = 22;
const N = 8;
const GAP = 16;
const GRID_W = CELL * N;
const PAD_LEFT = 32;
const PAD_RIGHT = 8;
const LABEL_H = 32;
const AXIS_H = 20;
const PAD_BOTTOM = 28;
const TOTAL_W = PAD_LEFT + 4 * GRID_W + 3 * GAP + PAD_RIGHT;
const GRID_Y = LABEL_H;
const TOTAL_H = GRID_Y + GRID_W + AXIS_H + PAD_BOTTOM;

interface CellData {
  i: number;
  j: number;
  fill: string;
  opacity: number;
}

// BigBird additional random cells (deterministic simulation)
const BIG_RANDOM = new Set(['1,3','2,5','3,6','4,2','5,7','6,3','7,4']);

// SSA content-selected cells (hardcoded to simulate semantic selection)
const SSA_ACTIVE = new Set([
  '0,0','0,4','0,7',
  '1,0','1,1','1,6',
  '2,2','2,3','2,7',
  '3,3','3,5',
  '4,0','4,4','4,7',
  '5,2','5,5','5,6',
  '6,1','6,6','6,7',
  '7,0','7,3','7,7',
]);

function buildCells(kind: 'full' | 'window' | 'bigbird' | 'ssa'): CellData[] {
  const out: CellData[] = [];
  for (let i = 0; i < N; i++) {
    for (let j = 0; j < N; j++) {
      const d = Math.abs(i - j);
      let fill: string;
      let opacity: number;
      if (kind === 'full') {
        fill = 'var(--accent)';
        opacity = Math.max(0.35, 1.0 - d * (0.65 / (N - 1)));
      } else if (kind === 'window') {
        const local = d <= 2;
        const global = j === 0;
        const active = local || global;
        fill = global && !local ? '#f97316' : active ? 'var(--accent)' : 'var(--bg-subtle)';
        opacity = active ? 0.85 : 1;
      } else if (kind === 'bigbird') {
        const local = d <= 1;
        const global = j === 0 || i === 0;
        const rand = BIG_RANDOM.has(`${i},${j}`);
        const active = local || global || rand;
        fill = global && !local ? '#f97316' : active ? 'var(--accent)' : 'var(--bg-subtle)';
        opacity = active ? 0.85 : 1;
      } else {
        const active = SSA_ACTIVE.has(`${i},${j}`);
        fill = active ? '#8b5cf6' : 'var(--bg-subtle)';
        opacity = active ? 0.85 : 1;
      }
      out.push({ i, j, fill, opacity });
    }
  }
  return out;
}

const grids = [
  { label: 'Full Attention', sub: 'O(n²)',         x: PAD_LEFT,                         cells: buildCells('full')    },
  { label: 'Longformer',     sub: 'O(n·w)',         x: PAD_LEFT + (GRID_W + GAP),        cells: buildCells('window')  },
  { label: 'BigBird',        sub: 'O(n·(w+g+r))',  x: PAD_LEFT + 2 * (GRID_W + GAP),    cells: buildCells('bigbird') },
  { label: 'SSA',            sub: 'O(n·k)',         x: PAD_LEFT + 3 * (GRID_W + GAP),    cells: buildCells('ssa')     },
];
---

<svg
  width="100%"
  viewBox={`0 0 ${TOTAL_W} ${TOTAL_H}`}
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; max-width: 100%; margin: 2rem 0; overflow: visible;"
  aria-label="Attention pattern comparison: full, Longformer window, BigBird, and SSA content-routed"
>
  <text
    x={PAD_LEFT - 6}
    y={GRID_Y + GRID_W / 2}
    text-anchor="middle"
    font-family="var(--font-sans)"
    font-size="10"
    fill="var(--text-muted)"
    transform={`rotate(-90, ${PAD_LEFT - 6}, ${GRID_Y + GRID_W / 2})`}
  >Query ↑</text>

  {grids.map((grid) => (
    <g>
      <text x={grid.x + GRID_W / 2} y={LABEL_H - 14}
        text-anchor="middle" font-family="var(--font-sans)"
        font-size="12" font-weight="600" fill="var(--text-muted)">
        {grid.label}
      </text>
      <text x={grid.x + GRID_W / 2} y={LABEL_H - 2}
        text-anchor="middle" font-family="var(--font-mono)"
        font-size="9" fill="var(--text-muted)">
        {grid.sub}
      </text>

      {grid.cells.map((cell) => (
        <rect
          x={grid.x + cell.j * CELL}
          y={GRID_Y + cell.i * CELL}
          width={CELL - 1} height={CELL - 1}
          fill={cell.fill} fill-opacity={cell.opacity} rx="2"
        />
      ))}

      {Array.from({ length: N - 1 }, (_, c) => c + 1).map((c) => (
        <line x1={grid.x + c * CELL} y1={GRID_Y}
              x2={grid.x + c * CELL} y2={GRID_Y + GRID_W}
              stroke="var(--border)" stroke-width="0.5" />
      ))}
      {Array.from({ length: N - 1 }, (_, r) => r + 1).map((r) => (
        <line x1={grid.x} y1={GRID_Y + r * CELL}
              x2={grid.x + GRID_W} y2={GRID_Y + r * CELL}
              stroke="var(--border)" stroke-width="0.5" />
      ))}
      <rect x={grid.x - 0.5} y={GRID_Y - 0.5}
            width={GRID_W + 1} height={GRID_W + 1}
            fill="none" stroke="var(--border)" stroke-width="0.5" />

      <text x={grid.x + GRID_W / 2} y={GRID_Y + GRID_W + AXIS_H - 4}
        text-anchor="middle" font-family="var(--font-sans)"
        font-size="10" fill="var(--text-muted)">← Key →</text>
    </g>
  ))}

  <!-- Legend -->
  <rect x={PAD_LEFT} y={TOTAL_H - 16} width="10" height="9" rx="1"
        fill="#f97316" fill-opacity="0.85" />
  <text x={PAD_LEFT + 14} y={TOTAL_H - 8}
        font-family="var(--font-sans)" font-size="9" fill="var(--text-muted)">
    global token
  </text>
  <rect x={PAD_LEFT + 88} y={TOTAL_H - 16} width="10" height="9" rx="1"
        fill="#8b5cf6" fill-opacity="0.85" />
  <text x={PAD_LEFT + 102} y={TOTAL_H - 8}
        font-family="var(--font-sans)" font-size="9" fill="var(--text-muted)">
    content-selected (SSA)
  </text>
</svg>
